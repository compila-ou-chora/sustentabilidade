# Copie este arquivo para ".env" e ajuste os valores antes de subir o
# ambiente com "docker compose up". O arquivo ".env" nunca deve ser
# commitado (ja esta no .gitignore).

# ------------------------------------------------------------------
# Banco de dados (Oracle - imagem gvenzl/oracle-free)
# ------------------------------------------------------------------
# Senha do usuario administrador (SYS/SYSTEM) do banco
ORACLE_PASSWORD=OraclePass_123

# Usuario/senha da aplicacao, criado automaticamente pela imagem do Oracle
DB_USER=sustentabilidade_app
DB_PASSWORD=AppPass_123

# ------------------------------------------------------------------
# Aplicacao (Spring Boot)
# ------------------------------------------------------------------
# Perfil ativo: staging ou production
SPRING_PROFILES_ACTIVE=staging

# Porta interna que o Spring Boot escuta dentro do container
SERVER_PORT=8080

# Porta exposta no host (ex.: 8080 para producao, 8081 para staging)
APP_PORT=8080

# Chave usada para assinar/validar os tokens JWT
JWT_SECRET=sustentabilidade-api-secret

# Imagem Docker usada pelo servico "app" (sobrescrita no pipeline de CI/CD
# com a imagem publicada no GHCR; em ambiente local pode manter o default)
APP_IMAGE=sustentabilidade-api:local
